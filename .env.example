# Copy to .env and fill in. Never commit .env.

# Shared key clients send in the X-API-Key header for writes (POST /expenses, approve,
# reject). Writes are refused with 401 if this is unset. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY=

# Anthropic API key, used by GET /expenses/insights.
ANTHROPIC_API_KEY=

# Where insights come from: "auto" (default) tries Claude and falls back to insights
# computed locally if the API fails; "rules" always computes them locally (no API call).
INSIGHTS_PROVIDER=auto

# FX rate API. Defaults to Frankfurter (free, no key), which is called as
#   GET {FX_API_URL}?from=USD&to=INR  ->  {"base": "USD", "rates": {"INR": 95.82}}
FX_API_URL=https://api.frankfurter.dev/v1/latest
FX_TIMEOUT_SECONDS=3

# Where the Streamlit UI (ui/app.py) finds the API.
API_BASE=http://127.0.0.1:8000

# SQLite database file.
DATABASE_URL=sqlite:///expenseflow.db
